{
  "name": "forge-ai-desktop",
  "productName": "Forge AI Desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Desktop shell for the Forge AI coding agent.",
  "keywords": [
    "forge",
    "ai",
    "coding-agent",
    "electron",
    "terminal"
  ],
  "license": "MIT",
  "author": {
    "name": "Boda Chen",
    "email": "chenboda01@users.noreply.github.com"
  },
  "main": ".vite/build/main.cjs",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "release": "electron-forge release",
    "lint": "oxlint && oxfmt --check",
    "lint:fix": "oxlint --fix && oxfmt --write",
    "test": "node --test test/*.test.mjs",
    "test:install": "bash scripts/test-install.sh"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-deb": "^8.0.1",
    "@electron-forge/maker-rpm": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-auto-unpack-natives": "^8.0.1",
    "@electron-forge/plugin-fuses": "^8.0.1",
    "@electron-forge/plugin-vite": "^8.0.1",
    "@electron/fuses": "^2.1.3",
    "@reforged/maker-appimage": "^6.0.0",
    "electron": "45.2.3",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.92.0",
    "vite": "^8.3.6"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron-squirrel-startup": "^1.0.1",
    "node-pty": "^1.1.0"
  },
  "allowScripts": {
    "node-pty@1.1.0": true
  }
}
