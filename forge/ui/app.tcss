Screen {
    background: $surface-canvas;
    color: $text-primary;
}

#startup-overlay {
    width: 100%;
    height: 100%;
    align: center middle;
    padding: 2 3;
    background: $surface-canvas;
}

#startup-logo {
    width: auto;
    height: auto;
    color: $accent-active;
    text-style: bold;
    content-align: center middle;
}

#startup-spacer {
    height: 1;
}

#startup-phase {
    width: auto;
    height: 1;
    color: $status-info;
    content-align: center middle;
}

#startup-progress {
    width: 100%;
    height: 1;
    margin-top: 1;
    content-align: center middle;
}

#shell {
    width: 100%;
    height: 100%;
    layout: horizontal;
}

#main {
    width: 1fr;
    height: 100%;
    background: $surface-main;
}

#conversation {
    width: 100%;
    height: 1fr;
    padding: 2 3;
    scrollbar-color: $accent-primary;
    scrollbar-background: $surface-main;
}

#eft-banner {
    width: 100%;
    height: 3;
    padding: 0 2;
    border-bottom: solid $accent-primary;
    background: $surface-elevated;
    color: $accent-active;
    text-style: bold;
}

.message {
    width: 100%;
    height: auto;
    margin-bottom: 2;
    color: $text-primary;
}

.message-user {
    border-left: tall $text-secondary;
    padding-left: 2;
}

.message-forge {
    border-left: tall $accent-primary;
    padding-left: 2;
}

.message-tool {
    color: $status-info;
    padding-left: 2;
}

.message-error {
    color: $status-error;
    border-left: tall $status-error;
    padding-left: 2;
}

#composer {
    width: 100%;
    height: 5;
    border: none;
    border-top: solid $border-subtle;
    padding: 0 2;
    background: $surface-main;
    color: $text-primary;
}

#activity-row {
    width: 100%;
    height: 2;
    padding: 0 2;
    background: $surface-main;
    color: $text-secondary;
}

#activity-label {
    width: 40;
    height: 1;
}

#agent-progress {
    width: 1fr;
    height: 1;
    color: $accent-primary;
    background: $surface-elevated;
}

#composer:focus {
    border-top: solid $accent-active;
    background: $surface-elevated;
}

#sidebar {
    width: 28;
    min-width: 24;
    max-width: 32;
    height: 100%;
    padding: 1 2;
    border-left: solid $border-subtle;
    background: $surface-rail;
    color: $text-secondary;
}

#sidebar-content {
    width: 100%;
    height: auto;
}

#sidebar-spacer {
    width: 100%;
    height: 1fr;
}

#sidebar-footer {
    width: 100%;
    height: auto;
    color: $text-muted;
}

ApprovalScreen {
    align: center middle;
    background: $surface-canvas 70%;
}

#approval-dialog {
    width: 64;
    max-width: 90%;
    height: auto;
    padding: 2;
    background: $surface-elevated;
    border: solid $accent-primary;
}

#approval-title {
    height: 2;
    color: $accent-active;
    text-style: bold;
}

#approval-body {
    height: auto;
    max-height: 16;
    color: $text-primary;
}

#approval-actions {
    height: 3;
    align-horizontal: right;
    margin-top: 1;
}

#approval-actions Button {
    margin-left: 1;
}

FastSelectScreen {
    align: center middle;
    background: $surface-canvas 70%;
}

#fast-dialog {
    width: 42;
    height: auto;
    padding: 2;
    background: $surface-elevated;
    border: solid $accent-primary;
}

#fast-title {
    height: 2;
    color: $accent-active;
    text-style: bold;
}

#fast-subtitle {
    height: 2;
    color: $text-secondary;
    margin-bottom: 1;
}

#fast-dialog Button {
    width: 100%;
    margin-bottom: 1;
}

#fast-dialog Button:focus {
    border: solid $accent-active;
}

ThemeSelectScreen {
    align: center middle;
    background: $surface-canvas 70%;
}

#theme-dialog {
    width: 28;
    height: auto;
    padding: 2;
    background: $surface-elevated;
    border: solid $accent-primary;
}

#theme-title {
    height: 2;
    color: $accent-active;
    text-style: bold;
}

#theme-subtitle {
    height: 2;
    color: $text-secondary;
    margin-bottom: 1;
}

#theme-dialog Button {
    width: 100%;
    margin-bottom: 1;
}

#theme-dialog Button:focus {
    border: solid $accent-active;
}
