Screen {
    background: $surface-canvas;
    color: $text-primary;
}

#startup-overlay {
    width: 100%;
    height: 100%;
    align: center middle;
    padding: 2 3;
    background: $surface-canvas;
}

#startup-emblem {
    width: auto;
    height: auto;
    color: $accent-primary;
    text-style: bold;
    content-align: center middle;
}

#startup-logo {
    width: auto;
    height: auto;
    margin-top: 1;
    color: $accent-active;
    text-style: bold;
    content-align: center middle;
}

#startup-tagline {
    width: auto;
    height: 1;
    margin-top: 1;
    color: $text-secondary;
    content-align: center middle;
}

#startup-spacer {
    height: 1;
}

#startup-phase {
    width: auto;
    height: 1;
    color: $status-info;
    content-align: center middle;
}

#startup-progress {
    width: 100%;
    height: 1;
    margin-top: 1;
    content-align: center middle;
}

#shell {
    width: 100%;
    height: 100%;
    layout: vertical;
}

#header, #footer {
    width: 100%;
    height: 1;
    box-sizing: content-box;
    background: $surface-rail;
    color: $text-secondary;
    text-style: dim;
}

#header {
    border-bottom: solid $border-subtle;
}

#footer {
    border-top: solid $border-subtle;
}

#header-left, #footer-left {
    width: 1fr;
    padding: 0 1;
}

#header-right, #footer-right {
    width: auto;
    padding: 0 1;
    color: $text-muted;
}

#body {
    width: 100%;
    height: 1fr;
    layout: horizontal;
}

#main {
    width: 1fr;
    height: 100%;
    background: $surface-main;
}

#conversation {
    width: 100%;
    height: 1fr;
    padding: 2 3;
    scrollbar-color: $accent-primary;
    scrollbar-background: $surface-main;
}

#eft-banner {
    width: 100%;
    height: 3;
    padding: 0 2;
    border-bottom: solid $accent-primary;
    background: $surface-elevated;
    color: $accent-active;
    text-style: bold;
}

.message {
    width: 100%;
    height: auto;
    margin-bottom: 2;
    padding-left: 2;
    color: $text-primary;
}

.message-user {
    background: $surface-elevated;
    border-left: thick $text-secondary;
}

.message-forge {
    border-left: thick $accent-primary;
}

.message-tool {
    color: $status-info;
}

.message-notice {
    color: $text-secondary;
}

.message-queued {
    color: $status-warning;
    border-left: thick $status-warning;
}

.message-error {
    color: $status-error;
    border-left: thick $status-error;
}

#composer {
    width: 100%;
    height: 4;
    border: round $border-subtle;
    padding: 0 1;
    background: $surface-main;
    color: $text-primary;
}

#activity-row {
    width: 100%;
    height: 2;
    padding: 0 2;
    background: $surface-main;
    color: $text-secondary;
}

#activity-label {
    width: 40;
    height: 1;
}

#agent-progress {
    width: 1fr;
    height: 1;
    color: $accent-primary;
    background: $surface-elevated;
}

#composer:focus {
    border: round $accent-active;
    background: $surface-elevated;
}

#composer.busy {
    border: round $status-warning;
}

#sidebar {
    width: 28;
    min-width: 24;
    max-width: 32;
    height: 100%;
    padding: 1 2;
    border-left: solid $border-subtle;
    background: $surface-rail;
    color: $text-secondary;
}

#sidebar-content {
    width: 100%;
    height: auto;
}

#sidebar-spacer {
    width: 100%;
    height: 1fr;
}

#sidebar-footer {
    width: 100%;
    height: auto;
    color: $text-muted;
}

ApprovalScreen {
    align: center middle;
    background: $surface-canvas 70%;
}

#approval-dialog {
    width: 64;
    max-width: 90%;
    height: auto;
    padding: 2;
    background: $surface-elevated;
    border: solid $accent-primary;
}

#approval-title {
    height: 2;
    color: $accent-active;
    text-style: bold;
}

#approval-body {
    height: auto;
    max-height: 16;
    color: $text-primary;
}

#approval-actions {
    height: 3;
    align-horizontal: right;
    margin-top: 1;
}

#approval-actions Button {
    margin-left: 1;
}

FastSelectScreen {
    align: center middle;
    background: $surface-canvas 70%;
}

#fast-dialog {
    width: 42;
    height: auto;
    padding: 2;
    background: $surface-elevated;
    border: solid $accent-primary;
}

#fast-title {
    height: 2;
    color: $accent-active;
    text-style: bold;
}

#fast-subtitle {
    height: 2;
    color: $text-secondary;
    margin-bottom: 1;
}

#fast-dialog Button {
    width: 100%;
    margin-bottom: 1;
}

#fast-dialog Button:focus {
    border: solid $accent-active;
}

ThemeSelectScreen {
    align: center middle;
    background: $surface-canvas 70%;
}

#theme-dialog {
    width: 28;
    height: auto;
    padding: 2;
    background: $surface-elevated;
    border: solid $accent-primary;
}

#theme-title {
    height: 2;
    color: $accent-active;
    text-style: bold;
}

#theme-subtitle {
    height: 2;
    color: $text-secondary;
    margin-bottom: 1;
}

#theme-dialog Button {
    width: 100%;
    margin-bottom: 1;
}

#theme-dialog Button:focus {
    border: solid $accent-active;
}

ModelSelectScreen,
CommandPaletteScreen {
    align: center middle;
    background: $surface-canvas 70%;
}

#model-dialog {
    width: 84;
    max-width: 95%;
    height: auto;
    max-height: 85%;
    padding: 2;
    background: $surface-elevated;
    border: solid $accent-primary;
}

#palette-dialog {
    width: 72;
    max-width: 95%;
    height: auto;
    max-height: 85%;
    padding: 2;
    background: $surface-elevated;
    border: solid $accent-primary;
}

#model-title,
#palette-title {
    height: 2;
    color: $accent-active;
    text-style: bold;
}

#model-subtitle,
#palette-subtitle {
    height: 2;
    color: $text-secondary;
    margin-bottom: 1;
}

#model-filter,
#palette-filter {
    margin-bottom: 1;
}

#model-options,
#palette-options {
    height: auto;
    max-height: 20;
    background: $surface-elevated;
}

SubagentSelectScreen {
    align: center middle;
    background: $surface-canvas 70%;
}

#agents-dialog {
    width: 84;
    max-width: 95%;
    height: auto;
    max-height: 85%;
    padding: 2;
    background: $surface-elevated;
    border: solid $accent-primary;
}

#agents-title {
    height: 2;
    color: $accent-active;
    text-style: bold;
}

#agents-subtitle {
    height: 2;
    color: $text-secondary;
    margin-bottom: 1;
}

#agents-body {
    height: 22;
}

#agents-options {
    width: 30;
    height: 100%;
    border: solid $border-subtle;
}

#agents-detail {
    width: 1fr;
    height: 100%;
    padding: 0 2;
    color: $text-secondary;
    overflow-y: auto;
}
